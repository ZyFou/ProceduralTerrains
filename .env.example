# Local development default: http://localhost:6062/api/v1
# Production with a separate API host: https://api.example.com/api/v1
VITE_API_URL=http://localhost:6062/api/v1
# Optional geocoder endpoint used by the Real terrain map search.
# Must implement the Nominatim-compatible /search query parameters.
VITE_GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
